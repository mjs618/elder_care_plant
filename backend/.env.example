# ==========================================
# Elder Care Platform - Environment Config
# Copy to .env and fill in your values
# ==========================================

# --- App Settings ---
APP_ENV=development
APP_NAME="Elder Care Platform"
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_32CHARS_MIN

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/elder_care
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT Settings ---
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- API Key (for 3rd-party integrations) ---
API_KEY_HEADER_NAME=X-API-Key

# --- SLA / Rate Limiting ---
# Per-minute limits per tenant tier
RATE_LIMIT_FREE=60
RATE_LIMIT_STANDARD=300
RATE_LIMIT_ENTERPRISE=3000

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Initial Super Admin (Platform Operator) ---
SUPERADMIN_EMAIL=admin@eldercare.com
SUPERADMIN_PASSWORD=CHANGE_ME_ON_FIRST_RUN

# --- Feature Flags ---
ENABLE_PGVECTOR=true
ENABLE_POSTGIS=false
